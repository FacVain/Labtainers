# parameter.config -- dns-nxdomain-anomaly
#
# Each student gets a different DGA seed and a different position of the
# registered C2 name in the DGA sequence. The same seed value is written into
# the resolver (to register the C2 name) and into client3 (to generate names).
#
# Milestone 3 TODO: infected client, rates, benign error rates, stale hostname.

DGA_SEED : RAND_REPLACE : resolver:/etc/nxlab/lab.conf;client3:/etc/nxlab/lab.conf : DGA_SEED_TOKEN : 10000 : 99999
C2_INDEX : RAND_REPLACE : resolver:/etc/nxlab/lab.conf : C2_INDEX_TOKEN : 60 : 150
