# start.config -- dns-nxdomain-anomaly
# One flat network (dns-net) with five containers.
#   resolver : BIND9 recursive resolver + authoritative .lab zone, DNS monitor, detector, RPZ response
#   web      : benign lab web sites (shop.lab, news.lab, ...)
#   client1  : benign user (browsing, typos, browser random probes)
#   client2  : benign user + misconfigured app polling a deleted hostname
#   client3  : infected host running the DGA malware simulator

GLOBAL_SETTINGS
    LAB_MASTER_SEED dns-nxdomain-anomaly_2522233_2834711_seed

NETWORK DNS_NET
    MASK 172.30.0.0/24
    GATEWAY 172.30.0.1

CONTAINER resolver
    USER ubuntu
    X11 NO
    DNS_NET 172.30.0.10

CONTAINER web
    USER ubuntu
    X11 NO
    TERMINALS 0
    DNS_NET 172.30.0.20

CONTAINER client1
    USER ubuntu
    X11 NO
    DNS_NET 172.30.0.101

CONTAINER client2
    USER ubuntu
    X11 NO
    DNS_NET 172.30.0.102

CONTAINER client3
    USER ubuntu
    X11 NO
    DNS_NET 172.30.0.103
