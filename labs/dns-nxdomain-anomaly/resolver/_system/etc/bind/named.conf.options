acl labnet { 172.30.0.0/24; 127.0.0.0/8; };

options {
    directory "/var/cache/bind";
    listen-on { any; };
    listen-on-v6 { none; };

    recursion yes;
    allow-query { labnet; };
    allow-recursion { labnet; };
    dnssec-validation no;

    // Use rndc querylog on when debugging DNS queries.
    // Apply client quarantine policy to local zone (same zone like .lab) responses too.
    response-policy { zone "rpz.local" min-update-interval 0; } recursive-only no;

};
